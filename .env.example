# PLANTILLA — solo nombres de variables, NUNCA valores.
#
# Los valores reales viven exclusivamente en:
#   Vercel → Project Settings → Environment Variables
#
# Para trabajar en local NO llenes este archivo a mano:
#   vercel link
#   vercel env pull .env.local
#
# Detalle completo: docs/19-DEPLOYMENT.md

# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # SOLO servidor. Nunca NEXT_PUBLIC_

# ── Siigo Nube Pro ───────────────────────────────────────
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
SIIGO_PARTNER_ID=
SIIGO_BASE_URL=

# ── Wompi ────────────────────────────────────────────────
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=                # verificación de firma del webhook
WOMPI_INTEGRITY_SECRET=

# ── Resend ───────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Cloudflare R2 ────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
